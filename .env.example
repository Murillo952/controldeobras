# ============================================================
# Copia este archivo y renómbralo a ".env" (sin ".example")
# Luego reemplaza los dos valores por los de tu proyecto de Supabase.
#
# - VITE_SUPABASE_URL:
#     Supabase -> Project Settings -> Data API -> "Project URL"
# - VITE_SUPABASE_ANON_KEY:
#     Supabase -> Project Settings -> API Keys -> "anon" / "public"
#     (a veces se llama "Publishable key")
#
# El archivo ".env" NO se sube a Git ni se comparte (ya está
# excluido en .gitignore). En Netlify, estas mismas dos variables
# se configuran desde Site settings -> Environment variables.
# ============================================================
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU-CLAVE-PUBLICA-AQUI